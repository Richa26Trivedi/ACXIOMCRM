<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="AcxiomCRM helps sales teams manage customers, leads, opportunities, activities, and reports." />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AcxiomCRM.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-xl navbar-dark">
            <div class="container-fluid app-shell">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">A</span>
                    <span><strong>Acxiom</strong><span class="brand-subtitle">CRM</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto ms-xl-4">
                        <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index"><span class="nav-icon">◫</span>Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index"><span class="nav-icon">◌</span>Customers</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Leads" asp-action="Index"><span class="nav-icon">◎</span>Leads</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Opportunities" asp-action="Index"><span class="nav-icon">◇</span>Opportunities</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="FollowUps" asp-action="Index"><span class="nav-icon">◔</span>Follow-Ups</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Activities" asp-action="Index"><span class="nav-icon">✦</span>Activities</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index"><span class="nav-icon">▣</span>Reports</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="AuditLogs" asp-action="Index"><span class="nav-icon">▤</span>Audit Logs</a></li>
                    </ul>

                    <ul class="navbar-nav align-items-xl-center">
                        <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index"><span class="nav-icon">◍</span>Users</a></li>
                        <li class="nav-item nav-logout"><a class="nav-link" asp-controller="Account" asp-action="Logout"><span class="nav-icon">↗</span>Logout</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="app-shell main-shell">
        <main role="main" class="page-content">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="app-shell d-flex flex-column flex-md-row align-items-center justify-content-between gap-2">
            <span>&copy; 2026 AcxiomCRM</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
