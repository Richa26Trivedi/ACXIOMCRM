@model IEnumerable<AcxiomCRM.Web.Models.Opportunity>
@{ ViewData["Title"] = "Opportunities"; }
<h1>Opportunities</h1>
<form method="get" class="row g-2 mb-3"><div class="col"><input name="search" class="form-control" placeholder="Search opportunity or customer" /></div><div class="col-md-3"><select name="stage" class="form-select"><option value="">All stages</option><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select></div><div class="col-auto"><button class="btn btn-primary">Search</button></div><div class="col-auto"><a class="btn btn-success" asp-action="Create">New Opportunity</a></div></form>
<table class="table table-striped"><thead><tr><th>Name</th><th>Customer</th><th>Stage</th><th>Amount</th><th>Probability</th><th>Expected Close</th><th></th></tr></thead><tbody>@foreach (var item in Model){<tr><td>@item.OpportunityName</td><td>@item.Customer?.CustomerName</td><td>@item.Stage</td><td>@item.Amount.ToString("C")</td><td>@item.Probability%</td><td>@item.ExpectedCloseDate?.ToString("d")</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a> <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete opportunity?');">Delete</button></form></td></tr>}</tbody></table>
