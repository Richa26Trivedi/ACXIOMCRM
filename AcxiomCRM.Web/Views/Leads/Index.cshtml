@model IEnumerable<AcxiomCRM.Web.Models.Lead>
@{ ViewData["Title"] = "Leads"; }
<h1>Leads</h1>
<form method="get" class="row g-2 mb-3"><div class="col"><input name="search" class="form-control" placeholder="Search lead, company or email" /></div><div class="col-md-3"><select name="status" class="form-select"><option value="">All statuses</option><option>New</option><option>Contacted</option><option>Qualified</option><option>Unqualified</option><option>Converted</option><option>Lost</option></select></div><div class="col-auto"><button class="btn btn-primary">Search</button></div><div class="col-auto"><a class="btn btn-success" asp-action="Create">New Lead</a></div></form>
<table class="table table-striped"><thead><tr><th>Name</th><th>Company</th><th>Status</th><th>Priority</th><th>Value</th><th>Owner</th><th></th></tr></thead><tbody>@foreach (var item in Model){<tr><td>@item.LeadName</td><td>@item.CompanyName</td><td>@item.Status</td><td>@item.Priority</td><td>@item.ExpectedValue.ToString("C")</td><td>@item.AssignedTo</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a> <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete lead?');">Delete</button></form></td></tr>}</tbody></table>
