@model IEnumerable<AcxiomCRM.Web.Controllers.UserAdminViewModel>
@{ ViewData["Title"] = "Users"; }
<h1>User Administration</h1>
<table class="table table-striped"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var item in Model){<tr><td>@item.User.FullName</td><td>@item.User.Email</td><td>@string.Join(", ", item.Roles)</td><td>@(item.User.IsActive ? "Active" : "Inactive")</td><td><a asp-action="Edit" asp-route-id="@item.User.Id" class="btn btn-sm btn-outline-primary">Manage</a></td></tr>}</tbody></table>
